# Copy to backend/.env (never commit real values).
# The app also reads these from the process environment (Render/Railway/etc).

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=6c33468360b54440b04c27e87997c890
SPOTIFY_CLIENT_SECRET=1a92c82791e342c9bf3d720b3cf900af
# Must match EXACTLY what you register in the Spotify dashboard, e.g.:
#   Local:  http://127.0.0.1:8000/api/auth/spotify/callback
#   Prod:   https://your-app.onrender.com/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback

# Random long string (generate: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=3719fec7311f088ef027b2eb0108761c3cce555bb509923c2aac3a3405e9d988
# Public URL of this app, used for share links (blank = auto-detect from request)
FRONTEND_URL=

ROOM_TTL_HOURS=24
GUEST_TOKEN_TTL_HOURS=24

# Set MOCK_SPOTIFY=1 for UI testing without Spotify credentials
MOCK_SPOTIFY=
